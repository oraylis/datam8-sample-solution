# Evaluate model-declared scalar metrics. No function names or check categories are inferred here.
for rule in monitoring_rules:
    projection = rule["definition"].get("datam8", {}).get("metrics")
    if projection is None:
        continue
    no_data = F.expr(projection["no_data_when"]) if "no_data_when" in projection else F.lit(False)
    from pyspark.sql.types import BooleanType
    if not isinstance(monitoring_checked_df.select(no_data).schema.fields[0].dataType, BooleanType):
        raise ValueError("Metric no_data_when must return BOOLEAN")
    failures = F.col("_errors" if rule["severity"] == "error" else "_warnings")
    failed = F.coalesce(F.exists(failures, lambda error: error["user_metadata"]["datam8_check_id"] == rule["id"]), F.lit(False))
    values = monitoring_checked_df.select(
        F.expr(projection["checked_rows"]).alias("checked_rows"),
        (F.expr(projection["failed_rows"]) if "failed_rows" in projection else F.lit(None)).alias("failed_rows"),
        (F.expr(projection["measured_value"]) if "measured_value" in projection else F.lit(None)).alias("measured_value"),
        F.when(no_data, "NO_DATA").when(failed, "FAILED").otherwise("PASSED").alias("status"),
    ).limit(2).collect()
    if len(values) != 1:
        raise ValueError("Projected quality metrics require exactly one input row")
    value = values[0]
    if value.checked_rows is None or value.checked_rows < 0 or int(value.checked_rows) != value.checked_rows:
        raise ValueError("Projected checked_rows must be a nonnegative integer")
    monitoring_metrics.append(quality_runtime.metric(
        rule, quality_context, "monitoring", value.checked_rows, value.failed_rows,
        value.measured_value, value.status,
    ))
