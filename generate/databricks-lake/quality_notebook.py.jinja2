# Databricks notebook source
# MAGIC %md
# MAGIC # Quality monitoring for {{ data.entity_name }}
# MAGIC Evaluate the complete committed target. Violations are recorded; technical errors fail this task.

# COMMAND ----------

from pyspark.sql import functions as F

dbutils.widgets.text("catalog_name", "")
dbutils.widgets.text("job_run_id", "")
catalog_name = dbutils.widgets.get("catalog_name")
job_run_id = dbutils.widgets.get("job_run_id")
if not catalog_name:
    raise ValueError("Set catalog_name explicitly before running this notebook")

# COMMAND ----------

{% if data.quality.enforcement %}
# MAGIC %md
# MAGIC ## Check the upstream load outcome
# MAGIC After a failed load, monitor only when this attempt committed valid rows and then exceeded the quality threshold.
# MAGIC Technical load failures do not start a quality evaluation. Successful empty loads retain their normal monitoring behavior.

# COMMAND ----------

dbutils.widgets.text("quality_upstream_task", "")
dbutils.widgets.text("quality_upstream_result", "")
dbutils.widgets.text("quality_upstream_attempt", "")
dbutils.widgets.text("quality_reference_results", "{}")
import json

if any(state != "success" for state in json.loads(dbutils.widgets.get("quality_reference_results")).values()):
    dbutils.notebook.exit("SKIPPED_REFERENCE_LOAD_FAILURE")
quality_upstream_task = dbutils.widgets.get("quality_upstream_task")
quality_upstream_result = dbutils.widgets.get("quality_upstream_result")
if quality_upstream_task and quality_upstream_result != "success":
    quality_gate_signal = dbutils.jobs.taskValues.get(
        taskKey=quality_upstream_task, key="quality_gate_after_write", default={},
    )
    quality_committed_gate = (
        quality_upstream_result == "failed" and isinstance(quality_gate_signal, dict)
        and quality_gate_signal.get("attempt") == dbutils.widgets.get("quality_upstream_attempt")
    )
    if not quality_committed_gate:
        dbutils.notebook.exit("SKIPPED_UPSTREAM_TECHNICAL_FAILURE_OR_NO_COMMITTED_ROWS")

# COMMAND ----------

{% endif %}
{% set quality_mode = 'monitoring' %}
{% include '_quality_init.py.jinja2' %}
# MAGIC %md
# MAGIC ## Read the committed target
# MAGIC No target rows are modified by this notebook.

# COMMAND ----------

monitoring_df = spark.table(quality_target)
quality_runtime.validate_target_columns(monitoring_df.schema)
monitoring_metrics = []
{% for group in data.quality.monitoring_groups %}
# COMMAND ----------

# MAGIC %md
# MAGIC ## {{ 'Aggregate monitoring query' if group.aggregate else 'Row monitoring on the complete target' }}
# MAGIC Validate the original Boolean expression before native DQX evaluation. Only TRUE passes.

# COMMAND ----------

{% if group.aggregate %}
monitoring_sql = {{ group.sql_literal | safe }}
print(monitoring_sql)
quality_runtime.validate_monitoring_query(spark, monitoring_sql)
monitoring_input_df = spark.sql(monitoring_sql, args=quality_query_args)
monitoring_value = quality_runtime.validate_aggregate_result(monitoring_input_df)
{% else %}
monitoring_input_df = monitoring_df
{% endif %}
monitoring_evaluation_df = monitoring_input_df.withColumn("__dm8_dq_evaluated_at", F.lit(quality_context["evaluatedAt"]))
monitoring_checks = quality_rules["checks"]["{{ group.key }}"]
quality_record_rules = [rule for rule in quality_rules["quality"]["checks"] if rule["id"] in {{ group.ids | tojson }}]
for rule in quality_record_rules:
    quality_runtime.validate_boolean_expression(monitoring_evaluation_df, quality_rules["compiled"][rule["id"]]["expression"])
quality_runtime.validate_check_inputs(monitoring_evaluation_df, monitoring_checks)
{% if group.aggregate %}
rule = quality_record_rules[0]
# no_data suppresses the business evaluation only after the SQL/result/Boolean contract is validated.
if monitoring_value["checked_rows"] == 0 and rule.get("onEmpty", "evaluate") == "no_data":
    monitoring_status = "NO_DATA"
else:
    monitoring_checked_df = quality_engine.apply_checks_by_metadata(monitoring_evaluation_df, monitoring_checks)
    monitoring_result = monitoring_checked_df.first()
    monitoring_failures = (monitoring_result["_errors"] or []) + (monitoring_result["_warnings"] or [])
    if any(failure["skipped"] for failure in monitoring_failures):
        raise ValueError("DQX skipped a monitoring check; refusing a partial evaluation")
    monitoring_status = "FAILED" if monitoring_failures else "PASSED"
monitoring_metrics.append(quality_runtime.metric(
    rule, quality_context, "monitoring", monitoring_value["checked_rows"], None,
    monitoring_value["measured_value"], monitoring_status,
))
{% else %}
monitoring_checked_df = quality_engine.apply_checks_by_metadata(monitoring_evaluation_df, monitoring_checks)
{% set quality_record_df = 'monitoring_checked_df' %}
{% set quality_metrics = 'monitoring_metrics' %}
{% set quality_execution = 'monitoring' %}
{% include '_quality_records.py.jinja2' %}
{% endif %}
{% endfor %}
# COMMAND ----------

# MAGIC %md
# MAGIC ## Persist and display monitoring results
# MAGIC Only the central metrics table is written. Replaying the same run/attempt does not append duplicate metrics.

# COMMAND ----------

monitoring_metric_df = quality_runtime.write_metrics(monitoring_metrics, quality_context)
if monitoring_metric_df is not None:
    display(monitoring_metric_df.select("check_id", "severity", "checked_rows", "failed_rows", "measured_value", "status"))
