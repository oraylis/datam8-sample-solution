quality_runtime.validate_check_inputs(monitoring_input_df, monitoring_checks, quality_reference_dfs)
monitoring_checked_df = quality_engine.apply_checks_by_metadata(monitoring_input_df, monitoring_checks, ref_dfs=quality_reference_dfs)
quality_record_rules = [rule for rule in monitoring_rules if "metrics" not in rule["definition"].get("datam8", {})]
