          "default": 1433
        },
        {
          "name": "username",
          "displayName": "username",
          "required": false,
          "type": "string"
        },
        {
          "name": "password",
          "displayName": "password",
          "required": false,
          "type": "secret"
        },
        {
          "name": "encrypt",
          "displayName": "encrypt",
          "required": false,
          "description": "Enable encrypted transport",
          "type": "boolean",
          "default": true
        },
        {
          "name": "trusted_connection",
          "displayName": "trusted_connection",
          "required": false,
          "description": "Use Windows authentication",
          "type": "boolean",
          "default": false
        },
        {
          "name": "workspace_url",
          "displayName": "workspace_url",
