          ]
        },
        {
          "name": "windows",
          "displayName": "Windows",
          "required": [
            "authMode",
            "host",
            "database",
            "port",
            "trusted_connection"
          ],
          "optional": [
            "encrypt"
          ]
        },
        {
          "name": "databricks_pat",
          "displayName": "Databricks (PAT)",
          "required": [
            "authMode",
            "database",
            "workspace_url",
            "warehouse_id",
            "uc_connection_name",
            "token"
          ],
          "optional": []
        },
        {
          "name": "databricks_oauth",
