          "displayName": "uc_connection_name",
          "required": false,
          "type": "string"
        },
        {
          "name": "token",
          "displayName": "token",
          "required": false,
          "type": "secret"
        },
        {
          "name": "client_id",
          "displayName": "client_id",
          "required": false,
          "type": "string"
        },
        {
          "name": "client_secret",
          "displayName": "client_secret",
          "required": false,
          "type": "secret"
        },
        {
          "name": "auth_scope",
          "displayName": "auth_scope",
          "required": false,
          "type": "string",
          "default": "all-apis"
        }
      ],
      "authModes": [
        {
          "name": "sql_user",
          "displayName": "Username / Password",
          "required": [
            "authMode",
            "host",
            "database",
            "port",
            "username",
            "password"
          ],
