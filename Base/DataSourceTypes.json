          "targetType": "int"
        },
        {
          "sourceType": "money",
          "targetType": "money"
        },
        {
          "sourceType": "nchar",
          "targetType": "string"
        },
        {
          "sourceType": "ntext",
          "targetType": "string"
        },
        {
          "sourceType": "numeric",
          "targetType": "decimal"
        },
