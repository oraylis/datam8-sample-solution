        {
          "name": "host",
          "displayName": "host",
          "required": false,
          "type": "string"
        },
        {
          "name": "database",
          "displayName": "database",
          "required": false,
          "type": "string"
        },
        {
          "name": "port",
          "displayName": "port",
          "required": false,
