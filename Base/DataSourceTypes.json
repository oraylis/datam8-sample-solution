          "sourceType": "xml",
          "targetType": "string"
        }
      ],
      "pluginId": "builtin:SQLServer",
      "connectionProperties": [
        {
          "name": "authMode",
          "type": "string",
          "required": true
        },
        {
          "name": "host",
          "type": "string",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "required": true
        },
        {
          "name": "port",
          "type": "number",
          "required": true,
          "default": 1433
        },
        {
          "name": "username",
          "type": "string",
          "required": false
        },
        {
          "name": "password",
          "type": "secret",
          "required": false
        },
        {
          "name": "trust_server_certificate",
          "required": false,
          "default": false,
          "type": "boolean",
          "description": "Trust unverifyable certificates, e.g. self-signed"
        },
        {
          "name": "trust_server_certificate_ca",
          "required": false,
          "type": "string",
          "description": "Path to a root ca to verify the server certificate against"
        },
        {
          "name": "encrypt",
          "required": false,
          "default": true,
          "type": "boolean",
          "description": "Activate SSL encryption"
        },
        {
          "name": "trusted_connection",
          "required": false,
          "default": false,
          "type": "boolean",
          "description": "Enables Windows Authentication"
        }
      ],
      "authModes": [
        {
          "name": "sql_user",
          "displayName": "Username / Password",
          "required": [
            "username",
            "password"
          ],
          "optional": [
            "trust_server_certificate",
            "trust_server_certificate_ca",
            "encrypt"
          ]
        },
        {
          "name": "windows",
          "displayName": "Windows Authentication",
          "required": [
            "trusted_connection"
          ],
          "optional": [
            "trust_server_certificate",
            "trust_server_certificate_ca",
            "encrypt"
          ]
        }
      ]
    }
  ]
}
