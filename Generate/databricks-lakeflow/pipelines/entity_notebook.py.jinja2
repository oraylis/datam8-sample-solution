# Databricks notebook source
from functools import reduce

from pyspark import pipelines as dp
from pyspark.sql import DataFrame
from pyspark.sql import functions as F

catalog_name = spark.conf.get("catalog_name")
schema_prefix = spark.conf.get("schema_prefix", "")


@dp.table(name="{{ data.pipeline.full_table_name }}")
def {{ data.pipeline.resource_key }}():
    source_frames: list[DataFrame] = []
{%- for source in data.pipeline.external_source_entries %}
    source_frames.append(
        spark.read.table(
            f"{catalog_name}.{schema_prefix}{{ source.source_zone }}.{{ source.source_full_table_name }}"
        ).selectExpr(
            {%- for expression in source.select_expressions %}
            "{{ expression | safe }}",
            {%- endfor %}
            "'{{ source.source_name }}' AS __SourceTable",
            "current_timestamp() AS __InsertTimestampUTC",
            "current_timestamp() AS __UpdateTimestampUTC",
            "current_timestamp() AS __InsertTimestampSourceUTC"
        )
    )
{%- endfor %}
{%- for source in data.pipeline.internal_sources %}
    source_frames.append(
        spark.readStream.option("skipChangeCommits", "true").table(
            f"{catalog_name}.{schema_prefix}{{ source.source_zone }}.{{ source.source_full_table_name }}"
        ).selectExpr(
            {%- for expression in source.select_expressions %}
            "{{ expression | safe }}",
            {%- endfor %}
            "'{{ source.source_name }}' AS __SourceTable",
            "current_timestamp() AS __InsertTimestampUTC",
            "current_timestamp() AS __UpdateTimestampUTC",
            "__UpdateTimestampUTC AS __InsertTimestampSourceUTC"
        )
    )
{%- endfor %}
    if not source_frames:
        raise ValueError("Entity {{ data.pipeline.full_table_name }} has no source frames.")
    return reduce(lambda left, right: left.unionByName(right), source_frames)
