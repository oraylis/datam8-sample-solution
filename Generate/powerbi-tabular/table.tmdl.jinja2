	partition {% if " " in data.table.partition.name %}'{{ data.table.partition.name }}'{% else %}{{ data.table.partition.name }}{% endif %} = m
		mode: {{ data.table.partition.mode }}
		source =
{%- for line in data.table.partition.source_lines %}
			{{ line }}
{%- endfor %}
