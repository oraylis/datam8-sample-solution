{# Demo template showcasing all new UnifiedEntityFactory methods #}
{%- for entity in model.get_entity_list_by_layer('stage') %}
{%- set file_path = helper.build_path("demo", "new-methods-showcase", entity.data_product, entity.data_module, entity.entity_name) %}
>>>>>>>>>> {{ file_path }}.py | py
# =============================================================================
# DataM8 Generator - New Methods Showcase Demo
# =============================================================================
# Entity: {{ entity.entity_name }}
# Data Product: {{ entity.data_product }}
# Data Module: {{ entity.data_module }}
# Layer: {{ entity.entity_layer }}
# =============================================================================

# COMMAND ----------

# MAGIC %md
# MAGIC # New UnifiedEntityFactory Methods Demo
# MAGIC 
# MAGIC This notebook demonstrates all the new methods available in UnifiedEntityFactory
# MAGIC for entity: **{{ entity.entity_name }}**

# COMMAND ----------

# MAGIC %md
# MAGIC ## 1. Column Filtering by Type (NEW METHOD)

# COMMAND ----------

# New generic column filtering methods - replaces custom_functions calls
business_key_columns = {{ entity.get_columns_by_type("BK") | tojson }}
scd0_columns = {{ entity.get_columns_by_type("SCD0") | tojson }}
scd1_columns = {{ entity.get_columns_by_type("SCD1") | tojson }}
scd2_columns = {{ entity.get_columns_by_type("SCD2") | tojson }}
surrogate_key_columns = {{ entity.get_columns_by_type("SK") | tojson }}

print("=== Column Type Analysis ===")
print(f"Business Key columns: {business_key_columns}")
print(f"SCD0 columns: {scd0_columns}")
print(f"SCD1 columns: {scd1_columns}")
print(f"SCD2 columns: {scd2_columns}")
print(f"Surrogate Key columns: {surrogate_key_columns}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 2. Column Filtering by Tags (NEW METHOD)

# COMMAND ----------

# New tag-based column filtering
partition_columns = {{ entity.get_columns_by_tag("partitions") | tojson }}
index_columns = {{ entity.get_columns_by_tag("index") | tojson }}
sensitive_columns = {{ entity.get_columns_by_tag("sensitive") | tojson }}

print("=== Tag-Based Column Analysis ===")
print(f"Partition columns: {partition_columns}")
print(f"Index columns: {index_columns}")  
print(f"Sensitive columns: {sensitive_columns}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 3. Source Configuration Access (NEW METHODS)

# COMMAND ----------

# New source configuration access methods
{%- set extract_config = entity.get_source_extract_config() %}
{%- set source_filter = entity.get_source_filter() %}
{%- set has_delta = entity.has_delta_extraction() %}

print("=== Source Configuration Analysis ===")
{%- if extract_config %}
print(f"Extract configuration exists: True")
{%- if extract_config.type %}
print(f"Extract mode: {{ extract_config.type.value }}")
{%- if extract_config.type.value == "delta" and extract_config.delta and extract_config.delta.column %}
print(f"Delta tracking column: {{ extract_config.delta.column }}")
{%- endif %}
{%- endif %}
{%- else %}
print("Extract configuration exists: False")
{%- endif %}

{%- if source_filter %}
print(f"Source filter: {{ source_filter }}")
{%- else %}
print("Source filter: None")
{%- endif %}

print(f"Has delta extraction: {{ has_delta }}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 4. Entity Parameters Access (NEW METHODS)

# COMMAND ----------

# New entity and attribute parameter access
{%- set entity_params = entity.get_entity_parameters() %}
entity_parameters = [
{%- for param in entity_params %}
    {
        "name": "{{ param.name }}",
        "value": "{{ param.value }}",
        {%- if param.custom %}
        "custom": {{ param.custom | tojson }}
        {%- endif %}
    },
{%- endfor %}
]

print("=== Entity Parameters ===")
if entity_parameters:
    for param in entity_parameters:
        print(f"Parameter {param['name']}: {param['value']}")
else:
    print("No entity parameters defined")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 5. Enhanced Attribute Information (NEW METHODS)

# COMMAND ----------

# New attribute-level information access
print("=== Enhanced Attribute Information ===")
{%- for column in entity.attributes %}
{%- set refactor_names = entity.get_attribute_refactor_names(column.name) %}
{%- set unit_attr = entity.get_attribute_unit(column.name) %}
{%- set attr_params = entity.get_attribute_parameters(column.name) %}

print(f"\n--- Column: {{ column.name }} ---")
print(f"  Type: {{ column.type.value if column.type else 'None' }}")
print(f"  Data Type: {{ column.targetDataType.type }}")
{%- if refactor_names %}
print(f"  Refactor Names: {{ refactor_names | tojson }}")
{%- endif %}
{%- if unit_attr %}
print(f"  Unit Attribute: {{ unit_attr }}")
{%- endif %}
print(f"  Parameter Count: {{ attr_params | length }}")
{%- if attr_params %}
{%- for param in attr_params %}
print(f"    Parameter: {{ param.name }} = {{ param.value }}")
{%- endfor %}
{%- endif %}
{%- endfor %}

# COMMAND ----------

# MAGIC %md
# MAGIC ## 6. Existing Properties (Still Available)

# COMMAND ----------

# These properties were already available and still work
print("=== Existing Properties Still Available ===")
print(f"Entity name: {{ entity.entity_name }}")
print(f"Entity layer: {{ entity.entity_layer }}")
print(f"Data product: {{ entity.data_product }}")
print(f"Data module: {{ entity.data_module }}")
print(f"Locator: {{ entity.locator }}")
print(f"Total attributes: {{ entity.attributes | length }}")

# Business key attributes (existing property)
business_key_attrs = {{ entity.business_key_attributes | map(attribute='name') | list | tojson }}
print(f"Business key attributes (old method): {business_key_attrs}")

# SCD2 attributes (existing property)  
scd2_attrs = {{ entity.scd2_attributes | map(attribute='name') | list | tojson }}
print(f"SCD2 attributes (old method): {scd2_attrs}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 7. Function Configurations (Already Available)

# COMMAND ----------

# These were already accessible but now better documented
print("=== Function Configurations ===")

# Store configuration
{%- if entity.store_config %}
print("Store configuration exists:")
{%- if entity.store_config.write_mode %}
print(f"  Write mode: {{ entity.store_config.write_mode }}")
{%- endif %}
{%- if entity.store_config.mode %}
print(f"  Store mode: {{ entity.store_config.mode.value }}")
{%- endif %}
{%- else %}
print("No store configuration")
{%- endif %}

# Trigger configuration
{%- if entity.trigger_config %}
print("Trigger configuration exists:")
{%- if entity.trigger_config.mode %}
print(f"  Trigger mode: {{ entity.trigger_config.mode.value }}")
{%- endif %}
{%- else %}
print("No trigger configuration")
{%- endif %}

# Transformations
{%- if entity.transformations %}
print(f"Transformations: {{ entity.transformations | length }}")
{%- for transformation in entity.transformations %}
print(f"  Step {{ transformation.stepNo }}: {{ transformation.name }} ({{ transformation.kind.value }})")
{%- endfor %}
{%- else %}
print("No transformations defined")
{%- endif %}

# COMMAND ----------

# MAGIC %md
# MAGIC ## Summary
# MAGIC 
# MAGIC This demo showcased all the new methods added to UnifiedEntityFactory:
# MAGIC 
# MAGIC ### New Column Filtering Methods:
# MAGIC - `entity.get_columns_by_type(type_name)` - Generic column filtering by type
# MAGIC - `entity.get_columns_by_tag(tag_name)` - Generic column filtering by tags
# MAGIC 
# MAGIC ### New Schema Access Methods:
# MAGIC - `entity.get_source_extract_config()` - Access ExtractConfig
# MAGIC - `entity.get_source_filter()` - Access source SQL filters
# MAGIC - `entity.has_delta_extraction()` - Check for delta extraction mode
# MAGIC - `entity.get_entity_parameters()` - Access entity-level parameters
# MAGIC - `entity.get_attribute_parameters(name)` - Access attribute-level parameters
# MAGIC - `entity.get_attribute_refactor_names(name)` - Access refactor names
# MAGIC - `entity.get_attribute_unit(name)` - Access unit attributes
# MAGIC 
# MAGIC ### Benefits:
# MAGIC - ✅ Cleaner template code (direct entity methods vs external functions)
# MAGIC - ✅ Better performance (no function call overhead)
# MAGIC - ✅ Enhanced schema access (full ModelDataEntity.json coverage)
# MAGIC - ✅ Consistent API across all templates
# MAGIC - ✅ Future-proof (works with both v1 and v2 schemas)

print("Demo completed successfully!")

<<<<<<<<<< {{ file_path }}.py | py
{%- endfor %}