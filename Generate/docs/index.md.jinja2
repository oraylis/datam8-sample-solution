## Zone Overview

{% for zone in doc.zones -%}
<details open>
  <summary><strong>{{ zone.display_name }}</strong> ({{ zone.entity_count }} entities)</summary>
  <p><em>Folder:</em> {{ zone.folder or "N/A" }} | <em>Target:</em> {{ zone.target_name or "N/A" }}</p>
  {% if zone.module_summaries %}
  <ul>
    {%- for module in zone.module_summaries %}
    <li>{{ module.product_display or module.product or "N/A" }} / {{ module.module_display or module.module or "N/A" }} - {{ module.entity_count }} entities</li>
    {%- endfor %}
  </ul>
  {% else %}
  <p>No module details available.</p>
  {% endif %}
</details>
{% endfor %}

