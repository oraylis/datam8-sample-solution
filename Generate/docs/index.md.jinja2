    ("External Sources", doc.stats.external_sources),
    ("Modeled Sources", doc.stats.modeled_sources),
    ("Relationships", doc.stats.relationship_count),
    ("Entities with Description", doc.stats.entities_with_descriptions),
] %}
<table>
  <tr>
  {% for metric in metrics -%}
    <td style="padding:12px; border:1px solid #ddd;">
      <div style="font-size:24px; font-weight:bold;">{{ metric[1] }}</div>
