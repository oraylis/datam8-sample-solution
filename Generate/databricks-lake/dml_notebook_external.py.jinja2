# Databricks notebook source
# MAGIC %md
# MAGIC # DML for {{ data.zone }}.{{ data.full_table_name }}

# COMMAND ----------

from pyspark.sql import functions as F  # noqa: F401
{% if data.use_connector and data.query_plan.timestamp_delta %}
from datetime import datetime
{% endif %}
{% if data.use_connector %}
from datam8_{{ data.connector_id }} import extract_data
{% endif %}

# COMMAND ----------

# MAGIC %md
# MAGIC ## Initialize base settings

# COMMAND ----------

# MAGIC %run ../../../../../../utils/MigrationFramework

# COMMAND ----------

# MAGIC %md
# MAGIC ## Initialize Extraction Framework

# COMMAND ----------

{% if not data.use_connector %}
# MAGIC %run ../../../../../../utils/ExtractionFramework
{% endif %}

# COMMAND ----------

dbutils.widgets.text("env", "dev", "Environment")
dbutils.widgets.text("catalog_name", "", "Catalog Name")
dbutils.widgets.text("schema_prefix", "", "Schema Prefix")
dbutils.widgets.text("owner", "datam8_sample_dev_owner", "Owner")
dbutils.widgets.text("job_run_id", "", "Job Run ID")
dbutils.widgets.text("keyvault_name", "aut0kvt0dev0campus", "Key Vault Name")

# COMMAND ----------

# Retrieve a job-level parameter (will use default if it doesn't exist)
env = dbutils.widgets.get("env")
catalog_name = dbutils.widgets.get("catalog_name")
schema_prefix = dbutils.widgets.get("schema_prefix")
owner = dbutils.widgets.get("owner")
job_run_id = dbutils.widgets.get("job_run_id")
keyvault_name = dbutils.widgets.get("keyvault_name")

# static values
zone = f"{schema_prefix}{{ data.zone }}" if schema_prefix else "{{ data.zone }}"
data_source = "{{ data.data_source }}"
data_source_display = "{{ data.data_source_display }}"
source_name = "{{ data.source_name }}"
full_table_name = "{{ data.full_table_name }}"
write_mode = "{{ data.write_mode }}"

# COMMAND ----------

print("Environment: %s" % env)
print("Catalog: %s" % catalog_name)
print("Schema: %s" % zone)
print("Table: %s" % full_table_name)
print("Owner: %s" % owner)
print("Data Source: %s" % data_source)
print("Data Source Display: %s" % data_source_display)
# print("Mode: %s" % run_mode)

# COMMAND ----------

catalog = Catalog(catalog_name)
catalog.schema = zone
catalog.set_active()

# COMMAND ----------

# MAGIC %md
# MAGIC ## Read data from source system

# COMMAND ----------

# DBTITLE 1,Get connection values
connection_secret = dbutils.secrets.get(scope=keyvault_name, key="{{ data.connection_secret_key }}")
source_location = {{ data.source_location | default("", true) | tojson }}
data_source_type = "{{ data.data_source_type or '' }}"
column_renames = {{ data.column_renames | default([], true) | tojson }}
delta_column_details = {{ data.delta_column_details | default([], true) | tojson }}
target_columns = {{ data.target_columns | default([], true) | tojson }}
props = {{ data.data_source_extended_properties | default({}, true) | tojson }}
props["password"] = connection_secret

# COMMAND ----------

# MAGIC %md
# MAGIC ## Extract source data

# COMMAND ----------
{% if data.extract_mode and data.extract_mode|lower == "delta" %}
# DBTITLE 1,Determine delta value
delta_column = "{{ data.delta_column or '' }}"
max_external = spark.sql(f"""
SELECT
  CAST(COALESCE(MAX(`{delta_column}`), '1970-01-01') AS STRING) AS MaxDelta
FROM `{catalog.name}`.`{zone}`.`{full_table_name}`
""").first()[0]

print(f"Using delta value: {max_external}")

# COMMAND ----------
{% endif %}
# DBTITLE 1,Execute extraction
{% if data.use_connector %}
{% if data.query_plan.is_query %}
pushdown_query = source_location
{% else %}
{% if data.query_plan.has_delta_filter %}
{% if data.query_plan.timestamp_delta %}
if max_external is not None:
    max_external_ts = datetime.strptime(max_external, "%Y-%m-%d %H:%M:%S.%f")
    max_external = str(max_external_ts.replace(microsecond=0))
{% endif %}
pushdown_query = f"""
    SELECT *
    FROM {source_location}
    WHERE {{ data.query_plan.delta_columns_csv }} > '{max_external}'
"""
{% else %}
pushdown_query = f"""
    SELECT *
    FROM {source_location}
"""
{% endif %}
{% endif %}
print(f"Query: {pushdown_query}")
table_df = extract_data(
    props,
    query=pushdown_query,
)
{% else %}
SourceTable = ExtractionFramework(source_location, "{{ data.extract_mode or '' }}", delta_column_details)
extractSourceTable = SourceTable

if not data_source_type:
    raise ValueError(f"Data source type is missing for '{data_source}'.")

extract_function = getattr(extractSourceTable, data_source_type, None)

if extract_function is None:
    raise AttributeError(
        f"ExtractionFramework does not implement '{data_source_type}' for '{data_source}'."
    )

table_df = extract_function(
    props
    {% if data.extract_mode and data.extract_mode|lower == "delta" %}, max_external{% endif %}
)
{% endif %}
# COMMAND ----------

# MAGIC %md
# MAGIC ## Finish extraction

# COMMAND ----------
# DBTITLE 1,Add technical columns
load_timestamp = F.current_timestamp()
table_df = (
    table_df
    .withColumn("__Year", F.year(load_timestamp).cast("smallint"))
    .withColumn("__Month", F.month(load_timestamp).cast("smallint"))
    .withColumn("__Day", F.dayofmonth(load_timestamp).cast("smallint"))
    .withColumn("__InsertTimestampUTC", load_timestamp)
)
# COMMAND ----------
# DBTITLE 1,Rename & select columns
for rename in column_renames:
    source_column = rename.get("source")
    target_column = rename.get("target")
    if not source_column or not target_column or source_column == target_column:
        continue
    table_df = table_df.withColumnRenamed(source_column, target_column)

if target_columns:
    table_df = table_df.select(*(["__Year","__Month","__Day","__InsertTimestampUTC"] + target_columns))
# COMMAND ----------

# MAGIC %md
# MAGIC ## Write to {{ data.zone | upper }} zone

# COMMAND ----------

(
    table_df.write
    .mode(write_mode)
    .saveAsTable(f"{catalog_name}.{zone}.{full_table_name}")
)

# COMMAND ----------

# DBTITLE 1,Update extraction status
record_count = table_df.count()
print(f"Extracted {record_count} records in extraction")
