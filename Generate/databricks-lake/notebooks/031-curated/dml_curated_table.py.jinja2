{% import 'databricks-lake/__collections/macro/common_python_snippets.py.jinja2' as py_snippets %}

{% for entity in model.get_curated_entity_list() %}
{# V2 unified structure - entity is UnifiedEntityFactory #}
{%- set table = entity.entity %}
{%- set entity_type = "curated" %}
{%- set data_product = entity.data_product %}
{%- set data_module = entity.data_module %}
{%- set entity_name = entity.entity_name %}
{% set full_table_name = data_product|string + "_" + data_module|string + "_" + entity_name|string %}
{%- set file_path = helper.build_path("notebooks", SystemProperties().curated_folder, "dml", data_product|string, data_module|string, entity_name|string)%}

{# V2 structure - use UnifiedEntityFactory functions #}
{%- if entity.functions and entity.functions.transformations %}
  {%- for transformation in entity.functions.transformations %}
    {%- if transformation.function and transformation.function.source %}
>>>>>>>>>> {{ file_path }}_functions/{{ transformation.name }}.py
{% include "Model/Curated/%s/%s/%s" % (data_product, data_module, transformation.function.source) %}
<<<<<<<<<<
    {%- endif %}
  {%- endfor %}
{%- endif %}

>>>>>>>>>> {{ file_path }}.py
{# V2 structure - use UnifiedEntityFactory #}
{%- set bk_cols = custom_functions.list_bk_columns(entity) %}
{%- set scd0_cols = custom_functions.list_scd0_columns(entity) %}
{%- set scd1_cols = custom_functions.list_scd1_columns(entity) %}
{%- set scd2_cols = custom_functions.list_scd2_columns(entity) %}
{%- set has_scd1 = len(scd1_cols) > 0 %}
{%- set has_scd2 = len(scd2_cols) > 0 %}
# Databricks notebook source
# MAGIC %md
# MAGIC # DML for {{entity_type}}.{{full_table_name}}
# MAGIC History configuration of this entity
# MAGIC - __Business Key Columns__: {{bk_cols}}
# MAGIC - __SCD0 columns__: {{scd0_cols}}
# MAGIC - __SCD1 columns__: {{scd1_cols}}
# MAGIC - __SCD2 columns__: {{scd2_cols}}

# COMMAND ----------

from pyspark.sql import functions as F
from delta import DeltaTable  # noqa: F401

# COMMAND ----------

{{ py_snippets.common_variables(entity_type, entity, SystemProperties) }}


# COMMAND ----------

# MAGIC %md
# MAGIC ## Execute functions

# COMMAND ----------

table_name = "`%(catalog)s`.`%(schema)s`.`%(table)s`" % {
  "catalog": catalog.name,
  "schema": curated_zone,
  "table": full_table_name,
}

functions = {}

{%- if entity.functions and entity.functions.transformations %}
{%- for transformation in entity.functions.transformations %}

# COMMAND ----------

# MAGIC %md
# MAGIC ### {{ transformation.name }}

# COMMAND ----------

functions["{{ transformation.name }}"] = {{ transformation.to_dict() | tojson(indent=2) }}

# COMMAND ----------

# MAGIC %run ./{{ table.name }}_functions/{{ transformation.name }}

{%- if transformation.kind.value != "function" or (transformation.function and transformation.function.source != "self") %}

# COMMAND ----------

business_function = business_function.withColumns({  # noqa: F821
  "__BusinessFunction": F.lit("{{ transformation.name }}"),
  "__InsertTimestampUTC": F.current_timestamp(),
})
functions["{{ transformation.name }}"]["df"] = business_function  # noqa: F501
{%- endif %}

# COMMAND ----------
{%- if entity.store_config and entity.store_config.write_mode == "merge" %}

# MAGIC %md
# MAGIC # Merge into {{entity_type}}

# COMMAND ----------

delta_table = DeltaTable.forName(spark, table_name)

merge_builder = (
    delta_table.alias("target")
    .merge(
        functions["{{ transformation.name }}"]["df"].alias("source"),
        condition="""
        {%- for column in bk_cols %}
            {%- if not loop.first %}
            AND source.`{{column}}` = target.`{{column}}`
            {%- else %}
            source.`{{column}}` = target.`{{column}}`
            {%- endif %}
        {%- endfor %}
            AND source.`__BusinessFunction` = target.`__BusinessFunction`
        """
    )
    .whenNotMatchedInsert(
        values={   
            {%- for column in table.attribute %}
            "{{column.name}}": "source.`{{column.name}}`",
            {%- endfor %}
            "__BusinessFunction": "source.__BusinessFunction",
            "__insertTimestampUTC": "source.__InsertTimestampUTC",
            "__updateTimestampUTC": "source.__InsertTimestampUTC",
        }
    )
    .whenMatchedUpdate(
        condition="""
            1 <> 1
        {%- for column in table.attribute %}
            {%- if column.name not in bk_cols %}
            OR source.`{{column.name}}` != target.`{{column.name}}`
            {%- endif %}
        {%- endfor %}  
        """,
        set={
            {%- for column in table.attribute %}
                {%- if column.name not in bk_cols %}
            "target.{{column.name}}": "source.{{column.name}}",
                {%- endif %}
            {%- endfor %}
            "__updateTimestampUTC": "source.__InsertTimestampUTC",
        }  
    )
)

merge_builder.execute()

{%- elif entity.store_config and entity.store_config.write_mode == "overwrite" %}

(
    functions["{{ transformation.name }}"]["df"]
    .withColumns({
        "__UpdateTimestampUTC": F.current_timestamp(),
    })
    .write.saveAsTable(table_name, mode="overwrite")
)

{%- elif transformation.kind.value == "function" and transformation.function and transformation.function.source == "self" %}

# MAGIC %md
# MAGIC result is directly written by business function
# MAGIC all load logic is defined within the business function

{%- else %}

# MAGIC %md
# MAGIC # Default append mode

# COMMAND ----------

(
    functions["{{ transformation.name }}"]["df"]
    .withColumns({
        "__UpdateTimestampUTC": F.current_timestamp(),
    })
    .write.saveAsTable(table_name, mode="append")
)

{%- endif -%}

{%- endfor %}
{%- else %}

# MAGIC %md
# MAGIC ## No transformations defined for this entity

# COMMAND ----------

print("No transformations configured for {{ entity_name }}")

{%- endif %}

<<<<<<<<<< {{ file_path }}.py
{%- endfor -%}