{% import 'databricks-lake/__collections/macro/common_python_snippets.py.jinja2' as py_snippets %}

{%- for entity in model.get_raw_entity_list() %}
  {%- if entity.model_object %}
    {# V1 structure #}
    {%- set table = entity.model_object.entity %}
    {%- set entity_type = entity.model_object.type.value %}
    {%- set data_product = table.dataProduct %}
    {%- set data_module = table.dataModule %}
    {%- set entity_name = table.name %}
  {%- else %}
    {# V2 unified structure - entity is UnifiedEntityFactory #}
    {%- set table = entity.entity %}
    {%- set entity_type = "raw" %}
    {%- set data_product = entity.data_product %}
    {%- set data_module = entity.data_module %}
    {%- set entity_name = entity.entity_name %}
  {%- endif %}
{# Ensure all variables are strings #}
  {%- set file_path = helper.build_path("notebooks", SystemProperties().raw_folder, "dml", data_product|string, data_module|string, entity_name|string) %}
>>>>>>>>>> {{ file_path }}.py | py
