resources:
  jobs:
    {{ data.job_key }}:
      name: {{ ("[${var.environment}] " + data.job_name) | tojson }}
      max_concurrent_runs: 1
      timeout_seconds: 1800
      tags:
        platform: databricks-lake
      parameters:
        - name: environment
          default: ${var.environment}
        - name: date_start
          default: ${var.date_start}
        - name: date_end
          default: ${var.date_end}
        - name: connection_prefix
          default: ${var.connection_prefix}
        - name: catalog_name
          default: ${var.catalog_name}
        - name: owner
          default: ${var.owner}
        - name: workspace_host
          default: ${workspace.host}
        - name: job_name
          default: "{{ '{{job.name}}' }}"
        - name: job_run_id
          default: "{{ '{{job.run_id}}' }}"
      tasks:
{% for task in data.tasks %}
        - task_key: {{ task.task_key }}
{% if task.depends_on is defined and task.depends_on %}
          depends_on:
{% for dependency in task.depends_on %}
            - task_key: {{ dependency }}
{% endfor %}
{% endif %}
{% if task.job_ref is defined and task.job_ref %}
          run_job_task:
            job_id: ${resources.jobs.{{ task.job_ref }}.id}
{% else %}
          notebook_task:
            notebook_path: ${workspace.root_path}/${var.notebook_path}/{{ task.notebook_path }}
            source: WORKSPACE
{%- set task_cluster_ref = task.cluster_ref or data.cluster_ref %}
{%- if task_cluster_ref %}
          existing_cluster_id: ${resources.clusters.{{ task_cluster_ref }}.id}
{%- else %}
          existing_cluster_id: ${var.{{ task.cluster_var | default(data.cluster_var) }}}
{%- endif %}
{% endif %}
{% endfor %}
