resources:
  jobs:
    {{ data.job_key }}:
      name: {{ data.job_name }}
      max_concurrent_runs: 1
      parameters:
        - name: environment
          default: ${var.environment}
        - name: catalog_name
          default: ${var.catalog_name}
        - name: owner
          default: ${var.owner}
        - name: workspace_host
          default: ${workspace.host}
        - name: job_name
          default: "{{ '{{job.name}}' }}"
        - name: job_run_id
          default: "{{ '{{job.run_id}}' }}"
      permissions:
        - service_principal_name: ${var.run_as_service_principal}
          level: "CAN_MANAGE_RUN"
        - group_name: ${var.permission_group_name}
          level: "CAN_MANAGE_RUN"
      tasks:
{% for task in data.tasks %}
        - task_key: {{ task.task_key }}
{% if task.job_ref is defined and task.job_ref %}
          run_job_task:
            job_id: ${resources.jobs.{{ task.job_ref }}.id}
{% else %}
          notebook_task:
            notebook_path: ${workspace.root_path}/${var.notebook_path}/{{ task.notebook_path }}
            source: WORKSPACE
{%- set task_cluster_ref = task.cluster_ref or data.cluster_ref %}
{%- if task_cluster_ref %}
          existing_cluster_id: ${resources.clusters.{{ task_cluster_ref }}.id}
{%- else %}
          existing_cluster_id: ${var.{{ task.cluster_var | default(data.cluster_var) }}}
{%- endif %}
{% endif %}
{% if task.depends_on %}
          depends_on:
{% for dependency in task.depends_on %}
            - task_key: {{ dependency }}
{% endfor %}
{% endif %}
{% endfor %}
