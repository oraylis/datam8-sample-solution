resources:
  jobs:
    {{ data.job_key }}:
      name: {{ data.job_name }}
      max_concurrent_runs: 1
      parameters:
        - name: environment
          default: ${var.environment}
        - name: catalog_name
          default: ${var.catalog_name}
        - name: schema_prefix
          default: ${var.schema_prefix}
        - name: owner
          default: ${var.owner}
        - name: workspace_host
          default: ${workspace.host}
        - name: job_name
          default: "{{ '{{job.name}}' }}"
        - name: job_run_id
          default: "{{ '{{job.run_id}}' }}"
      permissions:
        - group_name: ${var.permission_group_name}
          level: "CAN_MANAGE_RUN"
      tasks:
{% for task in data.tasks %}
        - task_key: {{ task.task_key }}
          run_job_task:
            job_id: ${resources.jobs.{{ task.job_ref }}.id}
{% if task.depends_on %}
          depends_on:
{% for dependency in task.depends_on %}
            - task_key: {{ dependency }}
{% endfor %}
{% endif %}
{% endfor %}
