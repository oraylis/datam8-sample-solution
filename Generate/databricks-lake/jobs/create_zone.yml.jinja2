resources:
  jobs:
    {{ data.job_key }}:
      name: {{ ("[${var.environment}] " + data.job_name) | tojson }}
      permissions:
        - service_principal_name: ${var.deploy_service_principal}
          level: IS_OWNER
        - service_principal_name: ${var.run_as_service_principal}
          level: CAN_MANAGE_RUN
      tags:
        platform: databricks-lake
      max_concurrent_runs: 1
      parameters:
        - name: environment
          default: ${var.environment}
        - name: date_start
          default: ${var.date_start}
        - name: date_end
          default: ${var.date_end}
        - name: connection_prefix
          default: ${var.connection_prefix}
        - name: catalog_name
          default: ${var.catalog_name}
        - name: owner
          default: ${var.owner}
        - name: workspace_host
          default: ${workspace.host}
        - name: job_name
          default: "{{ '{{job.name}}' }}"
        - name: job_run_id
          default: "{{ '{{job.run_id}}' }}"
{% if data.serverless %}
      environments:
        - environment_key: serverless
          spec:
            environment_version: "{{ data.environment_version }}"
{% endif %}
{% if data.job_clusters %}
      job_clusters:
{% for cluster in data.job_clusters %}
        - job_cluster_key: {{ cluster.job_cluster_key }}
          new_cluster: ${var.{{ cluster.job_cluster_key }}}
{% endfor %}
{% endif %}
      tasks:
{% for task in data.tasks %}
        - task_key: {{ task.task_key }}
{% if task.depends_on | default([]) %}
          depends_on:
{% for dependency in task.depends_on %}
            - task_key: {{ dependency }}
{% endfor %}
{% endif %}
          notebook_task:
            notebook_path: ${workspace.root_path}/${var.notebook_path}/{{ task.notebook_path }}
            base_parameters:
              replication_integration_status_id: '1'
              execution_status_id: '1'
            source: WORKSPACE
{% if data.serverless %}
          environment_key: serverless
{% elif data.default_job_cluster_key %}
          job_cluster_key: {{ data.default_job_cluster_key }}
{% endif %}
{% endfor %}
