resources:
  jobs:
    {{ data.job_key }}:
      name: {{ data.job_name }}
      max_concurrent_runs: 1
      parameters:
        - name: environment
          default: ${var.environment}
        - name: catalog_name
          default: ${var.catalog_name}
        - name: owner
          default: ${var.owner}
        - name: workspace_host
          default: ${workspace.host}
        - name: job_name
          default: "{{ '{{job.name}}' }}"
        - name: job_run_id
          default: "{{ '{{job.run_id}}' }}"
      permissions:
        - service_principal_name: ${var.run_as_service_principal}
          level: "CAN_MANAGE_RUN"
        - group_name: ${var.permission_group_name}
          level: "CAN_MANAGE_RUN"
{%- if data.job_clusters %}
      job_clusters:
{%- for cluster in data.job_clusters %}
        - job_cluster_key: {{ cluster.job_cluster_key }}
          new_cluster: ${var.{{ cluster.job_cluster_key }}}
{%- endfor %}
{%- endif %}
      tasks:
{% for task in data.tasks %}
        - task_key: {{ task.task_key }}
          notebook_task:
            notebook_path: ${workspace.root_path}/${var.notebook_path}/{{ task.notebook_path }}
            base_parameters:
              replication_integration_status_id: '1'
              execution_status_id: '1'
            source: WORKSPACE
          job_cluster_key: {{ data.default_job_cluster_key }}
{% endfor %}
