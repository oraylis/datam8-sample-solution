# Databricks notebook source
# MAGIC %md
# MAGIC # DML for {{ data.zone }}.{{ data.full_table_name }}

# COMMAND ----------

from pyspark.sql import functions as F  # noqa: F401

# COMMAND ----------

# MAGIC %md
# MAGIC ## Initialize base settings

# COMMAND ----------

# MAGIC %run ../../../../../../utils/MigrationFramework

# COMMAND ----------

dbutils.widgets.text("env", "dev", "Environment")
dbutils.widgets.text("catalog_name", "datam8_campus_dev_fka", "Catalog Name")
dbutils.widgets.text("owner", "datam8_sample_dev_owner", "Owner")
dbutils.widgets.text("job_run_id", "", "Job Run ID")

# dbutils.widgets.dropdown(
#     "run_mode",
#     "INFO",
#     ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
#     "Run Mode",
# )
#dbutils.widgets.text("sandbox", "_", "Sandbox")

# COMMAND ----------

# Retrieve a job-level parameter (will use default if it doesn't exist)
env = dbutils.widgets.get("env")
catalog_name = dbutils.widgets.get("catalog_name")
owner = dbutils.widgets.get("owner")
job_run_id = dbutils.widgets.get("job_run_id")
# run_mode = dbutils.widgets.get("run_mode")
# sandbox = dbutils.widgets.get("sandbox")

# static values
zone = "{{ data.zone }}"
data_source = "{{ data.data_source }}"
data_source_display = "{{ data.data_source_display }}"
source_name = "{{ data.source_name }}"
full_table_name = "{{ data.full_table_name }}"
write_mode = "{{ data.write_mode }}"

# COMMAND ----------

print("Environment: %s" % env)
print("Catalog: %s" % catalog_name)
print("Schema: %s" % zone)
print("Table: %s" % full_table_name)
print("Owner: %s" % owner)
print("Data Source: %s" % data_source)
print("Data Source Display: %s" % data_source_display)
# print("Mode: %s" % run_mode)

# COMMAND ----------

catalog = Catalog(catalog_name)
catalog.schema = zone
catalog.set_active()

# COMMAND ----------

# MAGIC %md
# MAGIC ## Read data from source system

# COMMAND ----------

# DBTITLE 1,Resolve source query through the Unity Catalog connection
source_location = {{ data.source_location | default("", true) | tojson }}
extract_mode = ("{{ data.extract_mode or '' }}").lower()
connection_name = {{ data.connection_name | tojson }}
remote_query_option = {{ data.remote_query_option | tojson }}
remote_query_database = {{ data.remote_query_database | tojson }}
remote_query_query = {{ (data.remote_query_query or "") | tojson }}
remote_query_dbtable = {{ (data.remote_query_dbtable or "") | tojson }}
source_filter = {{ (data.source_filter or "") | tojson }}
column_renames = {{ data.column_renames | default([], true) | tojson }}
target_columns = {{ data.target_columns | default([], true) | tojson }}

# COMMAND ----------

# MAGIC %md
# MAGIC ## Extract source data

# COMMAND ----------
{% if data.extract_mode and data.extract_mode|lower == "delta" %}
# DBTITLE 1,Determine delta value
delta_column = "{{ data.delta_column or '' }}"
max_raw = spark.sql(f"""
SELECT
  CAST(COALESCE(MAX(`{delta_column}`), '1970-01-01') AS STRING) AS MaxDelta
FROM `{catalog.name}`.`{zone}`.`{full_table_name}`
""").first()[0]

print(f"Using delta value: {max_raw}")

# COMMAND ----------
{% endif %}
# DBTITLE 1,Initialize framework & execute function
if not source_location:
    source_location = source_name

escaped_database = remote_query_database.replace("'", "''")
if remote_query_dbtable:
    escaped_table = remote_query_dbtable.replace("'", "''")
    remote_query_sql = (
        f"SELECT * FROM remote_query('{connection_name}', {remote_query_option} => "
        f"'{escaped_database}', dbtable => '{escaped_table}')"
    )
else:
    if extract_mode == "delta":
        delta_column = {{ (data.source_delta_column or data.delta_column or "") | tojson }}
        if not delta_column:
            raise ValueError("Delta extraction is missing its cursor column.")
        where_keyword = " AND " if " where " in f" {remote_query_query.lower()} " else " WHERE "
        remote_query_query += f"{where_keyword}[{delta_column}] > '{max_raw}'"
    escaped_query = remote_query_query.replace("'", "''")
    remote_query_sql = (
        f"SELECT * FROM remote_query('{connection_name}', {remote_query_option} => "
        f"'{escaped_database}', query => '{escaped_query}')"
    )
table_df = spark.sql(remote_query_sql)
if source_filter:
    table_df = table_df.filter(F.expr(source_filter))
if extract_mode == "delta" and remote_query_dbtable:
    delta_column = {{ (data.source_delta_column or data.delta_column or "") | tojson }}
    if not delta_column:
        raise ValueError("Delta extraction is missing its cursor column.")
    table_df = table_df.filter(F.col(delta_column) > F.lit(max_raw))
# COMMAND ----------

# MAGIC %md
# MAGIC ## Finish extraction

# COMMAND ----------
# DBTITLE 1,Add technical columns
load_timestamp = F.current_timestamp()
table_df = (
    table_df
    .withColumn("__Year", F.year(load_timestamp).cast("smallint"))
    .withColumn("__Month", F.month(load_timestamp).cast("smallint"))
    .withColumn("__Day", F.dayofmonth(load_timestamp).cast("smallint"))
    .withColumn("__InsertTimestampUTC", load_timestamp)
)
# COMMAND ----------
# DBTITLE 1,Rename & select columns
for rename in column_renames:
    source_column = rename.get("source")
    target_column = rename.get("target")
    if not source_column or not target_column or source_column == target_column:
        continue
    table_df = table_df.withColumnRenamed(source_column, target_column)

if target_columns:
    table_df = table_df.select(*(["__Year","__Month","__Day","__InsertTimestampUTC"] + target_columns))
# COMMAND ----------

# MAGIC %md
# MAGIC ## Write to RAW zone

# COMMAND ----------

(
    table_df.write
    .mode(write_mode)
    .saveAsTable(f"{catalog_name}.{zone}.{full_table_name}")
)

# COMMAND ----------

# DBTITLE 1,Update extraction status
record_count = table_df.count()
print(f"Extracted {record_count} records in extraction")
