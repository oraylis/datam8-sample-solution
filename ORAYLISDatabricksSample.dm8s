{
  "schemaVersion": "2.0.0",
  "basePath": "base",
  "modelPath": "model",
  "pluginsPath": "plugins",
  "generatorTargets": [
    {
      "name": "databricks",
      "isDefault": true,
      "sourcePath": "generate/databricks-lake",
      "outputPath": "output/databricks"
    },
    {
      "name": "powerbi",
      "isDefault": false,
      "sourcePath": "generate/powerbi-tabular",
      "outputPath": "output/powerbi"
    },
    {
      "name": "docs",
      "isDefault": false,
      "sourcePath": "generate/docs",
      "outputPath": "output/docs"
    }
  ]
}
