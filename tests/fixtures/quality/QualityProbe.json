      "ordinalNumber": 1,
      "name": "Id",
      "attributeType": "ID",
      "dataType": {
        "type": "int",
        "nullable": true
      },
      "isBusinessKey": true,
      "dateAdded": "2026-01-01T00:00:00Z"
    },
    {
      "ordinalNumber": 2,
      "name": "Amount",
      "attributeType": "Regular",
      "dataType": {
        "type": "double",
        "nullable": true
      },
      "isBusinessKey": false,
      "dateAdded": "2026-01-01T00:00:00Z"
    },
    {
      "ordinalNumber": 3,
      "name": "Email",
      "attributeType": "Regular",
      "dataType": {
        "type": "string",
        "nullable": true
      },
      "isBusinessKey": false,
      "dateAdded": "2026-01-01T00:00:00Z"
    },
    {
      "ordinalNumber": 4,
      "name": "Updated",
      "attributeType": "Regular",
      "dataType": {
        "type": "datetime",
        "nullable": true
      },
      "isBusinessKey": false,
      "dateAdded": "2026-01-01T00:00:00Z"
    }
  ],
  "sources": [],
  "relationships": [],
  "transformations": [
    {
      "stepNo": 1,
      "name": "quality_probe_input",
      "kind": "function",
      "function": {
        "source": "QualityProbe.py"
      }
    }
  ],
  "properties": [
    {
      "property": "jobs",
      "value": "sales_daily"
    },
    {
      "property": "write_mode",
      "value": "overwrite"
    }
  ],
  "quality": {
    "settings": {
      "maxFailureRatePct": 25,
      "inputs": {
        "summary": {
          "sql": "SELECT\n  COUNT(*) AS `__dm8_total`,\n  COUNT(`Email`) / NULLIF(COUNT(*), 0) AS `__dm8_q_email_completeness`,\n  CAST(:evaluated_at AS DOUBLE) - CAST(MAX(`Updated`) AS DOUBLE) AS `__dm8_q_updated_fresh`,\n  COUNT(*) AS `__dm8_q_row_count`\nFROM {target_table}"
        }
      }
    },
    "checks": [
      {
        "id": "id_required",
        "execution": "enforcement",
        "definition": {
          "criticality": "error",
          "check": {
            "function": "is_not_null",
            "arguments": {
              "column": "`Id`"
            }
          }
        }
      },
      {
        "id": "amount_range",
        "execution": "enforcement",
        "definition": {
          "criticality": "error",
          "check": {
            "function": "is_not_less_than",
            "arguments": {
              "column": "`Amount`",
              "limit": 0
            }
          }
        }
      },
      {
        "id": "email_present",
        "execution": "enforcement",
        "definition": {
          "criticality": "warn",
          "check": {
            "function": "sql_expression",
            "arguments": {
              "expression": "COALESCE((Email IS NOT NULL), FALSE)",
              "msg": "email_present"
            }
          }
        }
      },
      {
        "id": "email_completeness",
        "execution": "monitoring",
        "definition": {
          "criticality": "warn",
          "datam8": {
            "input": "summary",
            "metrics": {
              "checked_rows": "`__dm8_total`",
              "measured_value": "`__dm8_q_email_completeness`",
              "no_data_when": "`__dm8_total` = 0"
            }
          },
          "check": {
            "function": "sql_expression",
            "arguments": {
              "expression": "COALESCE((`__dm8_q_email_completeness` >= 0.95), FALSE)",
              "msg": "email_completeness"
            }
          }
        }
      },
      {
        "id": "updated_fresh",
        "execution": "monitoring",
        "definition": {
          "criticality": "error",
          "datam8": {
            "input": "summary",
            "metrics": {
              "checked_rows": "`__dm8_total`",
              "measured_value": "`__dm8_q_updated_fresh`"
            }
          },
          "check": {
            "function": "sql_expression",
            "arguments": {
              "expression": "COALESCE((`__dm8_q_updated_fresh` BETWEEN 0 AND 300), FALSE)",
              "msg": "updated_fresh"
            }
          }
        }
      },
      {
        "id": "row_count",
        "execution": "monitoring",
        "definition": {
          "criticality": "error",
          "datam8": {
            "input": "summary",
            "metrics": {
              "checked_rows": "`__dm8_total`",
              "measured_value": "`__dm8_q_row_count`"
            }
          },
          "check": {
            "function": "sql_expression",
            "arguments": {
              "expression": "COALESCE((`__dm8_q_row_count` >= 1), FALSE)",
              "msg": "row_count"
            }
          }
        }
      }
    ]
  }
}
