  "sources": [],
  "relationships": [],
  "transformations": [
    {
      "stepNo": 1,
      "name": "quality_probe_input",
      "kind": "function",
      "function": {
        "source": "QualityProbe.py"
      }
    }
  ],
  "properties": [
    {
      "property": "jobs",
      "value": "sales_daily"
    },
    {
      "property": "write_mode",
      "value": "overwrite"
    }
  ],
  "quality": {
    "maxFailureRatePct": 25,
    "checks": [
      {
        "id": "id_required",
        "execution": "enforcement",
        "expression": "Id IS NOT NULL"
      },
      {
        "id": "amount_range",
        "execution": "enforcement",
        "expression": "COALESCE(Amount >= 0, FALSE)"
      },
      {
        "id": "email_present",
        "execution": "enforcement",
        "severity": "warning",
        "expression": "Email IS NOT NULL"
      },
      {
        "id": "email_completeness",
        "execution": "monitoring",
        "severity": "warning",
        "sql": "SELECT COUNT(*) AS checked_rows, COUNT(Email) * 1.0 / NULLIF(COUNT(*), 0) AS measured_value FROM {target}",
        "expression": "COALESCE(measured_value >= 0.95, FALSE)",
        "onEmpty": "no_data"
      },
      {
        "id": "updated_fresh",
        "execution": "monitoring",
        "sql": "SELECT COUNT(*) AS checked_rows, TIMESTAMPDIFF(MICROSECOND, MAX(Updated), CURRENT_TIMESTAMP) / 1000000.0 AS measured_value FROM {target}",
        "expression": "COALESCE(measured_value BETWEEN 0 AND 300, FALSE)"
      },
      {
        "id": "row_count",
        "execution": "monitoring",
        "sql": "SELECT COUNT(*) AS checked_rows, COUNT(*) AS measured_value FROM {target}",
        "expression": "COALESCE(measured_value >= 1, FALSE)"
      }
    ]
  }
}
