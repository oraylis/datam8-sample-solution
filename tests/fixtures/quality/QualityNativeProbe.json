      {
        "id": "native_unique_target",
        "execution": "monitoring",
        "expression": "Id IS NULL OR COUNT(*) OVER (PARTITION BY Id) = 1"
      },
      {
        "id": "native_reference",
        "execution": "monitoring",
        "sql": "SELECT COUNT(*) AS checked_rows, SUM(CASE WHEN t.Id IS NOT NULL AND r.Id IS NULL THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(*), 0) AS measured_value FROM {target} t LEFT JOIN (SELECT DISTINCT Id FROM {references.permitted}) r ON t.Id = r.Id",
        "expression": "measured_value = 0",
        "onEmpty": "no_data"
      }
    ]
